# Private settings: credentials and personal domains. Not in git; copy to every machine that runs the agent.
# List values are added to the same list in config.yaml.
adguard_username: ""
adguard_password: ""
openai_api_key: your_openai_api_key_here

# Optional: personal entries for any list in config.yaml, for example
trusted_domains:
  - example.com # my own site
